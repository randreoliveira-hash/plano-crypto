//@version=5
// MCI (Macro Confluence Index) — indicador único, cálculo interno completo.
// Fórmula aprovada: p = 0.50·p_MVRVZ(4a) + 0.10·p_RSI1W(4a) + 0.20·p_FG(1a) + 0.20·p_Puell(4a)
//                   MCI = 100 · p^α / (p^α + (1−p)^α), α = 2.0
// Componentes (validados contra o MCI real do bot — correlação 0.977):
//   1. MVRV Z  — REAL:  COINMETRICS:BTC_MVRV + GLASSNODE:BTC_MARKETCAP
//   2. RSI 1W  — real (nativo)
//   3. F&G     — proxy: fórmula oficial alternative.me com as partes computáveis (vol+momentum+tendência)
//   4. Puell   — proxy exata: emissão determinística (halvings) × preço / MA365  (corr 0.98)
// Use em gráfico DIÁRIO do BTC. Se um componente falhar, os pesos renormalizam.

indicator("MCI (Macro Confluence Index)", shorttitle="MCI", overlay=false, max_bars_back=1500)

// ===== Configuração =====
alpha = 2.0
win4a = 1460
win1a = 365

// ===== 1) MVRV Z-Score (dados on-chain reais) =====
mcap  = request.security("GLASSNODE:BTC_MARKETCAP", "", close, lookahead=barmerge.lookahead_off)
mvrvR = request.security("COINMETRICS:BTC_MVRV",    "", close, lookahead=barmerge.lookahead_off)
realCap = mvrvR > 0 ? mcap / mvrvR : na
zScore  = not na(realCap) ? (mcap - realCap) / ta.stdev(mcap, win4a) : na
pMvrv   = na(zScore) ? na : ta.percentrank(zScore, win4a) / 100.0

// ===== 2) RSI semanal (nativo) =====
rsiW = request.security(syminfo.tickerid, "W", ta.rsi(close, 14), lookahead=barmerge.lookahead_off)
pRsi = ta.percentrank(rsiW, win4a) / 100.0

// ===== 3) Fear & Greed (proxy da fórmula oficial) =====
// oficial: volatilidade 25% + momentum 25% + dominância 10% + tendência 10% + volume 5%
// computável no gráfico: volatilidade, momentum, tendência (60% do peso → renormaliza)
vol30    = ta.stdev(close, 30)
volMax   = ta.highest(vol30, 730)
volNorm  = volMax > 0 ? 1 - vol30 / volMax : na          // 25%
mom30    = close / close[30] - 1
momNorm  = mom30 <= 0 ? 25.0 : mom30 <= 0.05 ? 50.0 : mom30 <= 0.10 ? 75.0 : 100.0   // 25%
trend90  = ta.sma(close, 90)
trendChg = trend90 / trend90[93] - 1
trendNorm= trendChg <= 0 ? 25.0 : trendChg <= 0.05 ? 50.0 : trendChg <= 0.10 ? 75.0 : 100.0  // 10%
fgProxy  = (nz(volNorm) * 25 + momNorm * 25 + trendNorm * 10) / 60.0
pFg      = ta.percentrank(fgProxy, win1a) / 100.0

// ===== 4) Puell Multiple (proxy exata: agenda de halvings é determinística) =====
halv2024 = timestamp("2024-04-20T00:00:00")
halv2020 = timestamp("2020-05-11T00:00:00")
halv2016 = timestamp("2016-07-09T00:00:00")
halv2012 = timestamp("2012-11-28T00:00:00")
epoch = time >= halv2024 ? 4 : time >= halv2020 ? 3 : time >= halv2016 ? 2 : time >= halv2012 ? 1 : 0
subsidio = 50.0 / math.pow(2, epoch)          // BTC por bloco
issUSD   = 144.0 * subsidio * close           // emissão diária em USD (~144 blocos/dia)
puell    = issUSD / ta.sma(issUSD, 365)
pPuell   = ta.percentrank(puell, win4a) / 100.0

// ===== Combinação (50/10/20/20, renormaliza o que faltar) =====
wS = 50.0 * (not na(pMvrv) ? 1 : 0) + 10.0 + 20.0 + 20.0 * (not na(pPuell) ? 1 : 0)
p  = (50.0 * nz(pMvrv) + 10.0 * nz(pRsi) + 20.0 * nz(pFg) + 20.0 * nz(pPuell)) / wS

// ===== Contraste =====
mci = 100 * math.pow(p, alpha) / (math.pow(p, alpha) + math.pow(1 - p, alpha))

// ===== Zonas (as 7 aprovadas) =====
zonaNome(m) =>
    m < 5  ? "Capitulação Extrema"
    : m < 10 ? "Capitulação"
    : m < 30 ? "Acumulação"
    : m < 70 ? "Neutro"
    : m < 90 ? "Aquecido"
    : m < 98 ? "Alerta Máximo"
    : "Euforia"

zonaCor(m) =>
    m < 5  ? color.rgb(29, 78, 216)
    : m < 10 ? color.rgb(37, 99, 235)
    : m < 30 ? color.rgb(34, 211, 238)
    : m < 70 ? color.rgb(52, 211, 153)
    : m < 90 ? color.rgb(251, 191, 36)
    : m < 98 ? color.rgb(249, 115, 22)
    : color.rgb(239, 68, 68)

// ===== Visual =====
colZona = zonaCor(mci)
plot(mci, "MCI", color=colZona, linewidth=2)
hline(98, "Euforia",           color=color.rgb(239,68,68), linestyle=hline.style_dashed)
hline(90, "Alerta Máximo",     color=color.rgb(249,115,22), linestyle=hline.style_dashed)
hline(70, "Aquecido",          color=color.rgb(251,191,36), linestyle=hline.style_dashed)
hline(30, "Acumulação",        color=color.rgb(34,211,238), linestyle=hline.style_dashed)
hline(10, "Capitulação",       color=color.rgb(37,99,235), linestyle=hline.style_dashed)
hline(5,  "Capitulação Extrema", color=color.rgb(29,78,216), linestyle=hline.style_dashed)
bgcolor(colZona, transp=92)

var label lbl = na
if barstate.islast
    label.delete(lbl)
    lbl := label.new(bar_index, mci, "MCI " + str.tostring(mci, "#.#") + " — " + zonaNome(mci),
                     style=label.style_label_left, color=colZona, textcolor=color.white, size=size.small)
