//@version=5
// MCI (Macro Confluence Index) v2 — indicador único, cálculo interno completo.
// Calibrado contra o MCI real do bot (dados on-chain completos):
//   correlação 0.9915 (2018+), erro médio 3.1 pontos, 80% dos dias com erro ≤5,
//   mesma zona em 82% dos dias. Out-of-sample (2023+): 0.988.
// Fórmula: p = (48·p_MVRVZ + 10·p_RSI1W + 18·p_FG + 16·p_Puell) / 92
//          MCI = 100 · p^1.9 / (p^1.9 + (1−p)^1.9)
// Componentes:
//   1. MVRV Z  — REAL:  COINMETRICS:BTC_MVRV + GLASSNODE:BTC_MARKETCAP
//   2. RSI 1W  — real (nativo)
//   3. F&G     — proxy calibrada (corr 0.93 com o F&G real)
//   4. Puell   — proxy: 146 blocos/dia (mediana real) × subsídio × preço / MA365
// Use em gráfico DIÁRIO do BTC. Se um componente falhar, os pesos renormalizam.

indicator("MCI (Macro Confluence Index)", shorttitle="MCI", overlay=false, max_bars_back=1500)

alpha = 1.9
win4a = 1460
win1a = 365

// ===== 1) MVRV Z-Score (dados on-chain reais) =====
mcap  = request.security("GLASSNODE:BTC_MARKETCAP", "", close, lookahead=barmerge.lookahead_off)
mvrvR = request.security("COINMETRICS:BTC_MVRV",    "", close, lookahead=barmerge.lookahead_off)
realCap = mvrvR > 0 ? mcap / mvrvR : na
zScore  = not na(realCap) ? (mcap - realCap) / ta.stdev(mcap, win4a) : na
pMvrv   = na(zScore) ? na : ta.percentrank(zScore, win4a) / 100.0

// ===== 2) RSI semanal (nativo) =====
rsiW = request.security(syminfo.tickerid, "W", ta.rsi(close, 14), lookahead=barmerge.lookahead_off)
pRsi = ta.percentrank(rsiW, win4a) / 100.0

// ===== 3) Fear & Greed (proxy calibrada, corr 0.93) =====
vol30  = ta.stdev(close, 30)
volN   = 1 - vol30 / ta.highest(vol30, 730)                        // volatilidade (1 ponto)
above  = (close > ta.sma(close, 200) ? 50.0 : 0.0) + (close > ta.sma(close, 30) ? 50.0 : 0.0)  // 20%
hh90   = ta.highest(close, 90)
ll90   = ta.lowest(close, 90)
pos90  = hh90 > ll90 ? 100.0 * (close - ll90) / (hh90 - ll90) : 50.0
posB   = pos90 > 75 ? 100.0 : pos90 > 50 ? 75.0 : pos90 > 25 ? 50.0 : 25.0    // 30%
vsMA   = close / ta.sma(close, 365) - 1
vsMAb  = vsMA > 0.5 ? 100.0 : vsMA > 0.2 ? 75.0 : vsMA > 0.0 ? 50.0 : vsMA > -0.2 ? 25.0 : 0.0  // 35%
momo   = close / close[90] - 1
momoB  = momo > 0.3 ? 100.0 : momo > 0.1 ? 75.0 : momo > 0.0 ? 50.0 : momo > -0.2 ? 25.0 : 0.0  // 15%
rsiD   = ta.rsi(close, 14)
rsiB   = rsiD > 75 ? 100.0 : rsiD > 55 ? 75.0 : rsiD > 45 ? 50.0 : rsiD > 25 ? 25.0 : 0.0     // 3%
fgRaw  = 11.0 * above + 16.0 * posB + 28.0 * vsMAb + 13.0 * momoB + 1.0 * volN * 100 + 3.0 * rsiB + 10.4
pFg    = ta.percentrank(fgRaw, win1a) / 100.0

// ===== 4) Puell Multiple (proxy: emissão determinística) =====
halv2024 = timestamp("2024-04-20T00:00:00")
halv2020 = timestamp("2020-05-11T00:00:00")
halv2016 = timestamp("2016-07-09T00:00:00")
halv2012 = timestamp("2012-11-28T00:00:00")
epoch = time >= halv2024 ? 4 : time >= halv2020 ? 3 : time >= halv2016 ? 2 : time >= halv2012 ? 1 : 0
subsidio = 50.0 / math.pow(2, epoch)
issUSD   = 146.0 * subsidio * close
puell    = issUSD / ta.sma(issUSD, 365)
pPuell   = ta.percentrank(puell, win4a) / 100.0

// ===== Combinação (48/10/18/16, renormalizada) =====
wS = 48.0 * (not na(pMvrv) ? 1 : 0) + 10.0 + 18.0 + 16.0 * (not na(pPuell) ? 1 : 0)
p  = (48.0 * nz(pMvrv) + 10.0 * nz(pRsi) + 18.0 * nz(pFg) + 16.0 * nz(pPuell)) / wS

// ===== Contraste =====
mci = 100 * math.pow(p, alpha) / (math.pow(p, alpha) + math.pow(1 - p, alpha))

// ===== Zonas (as 7 aprovadas) =====
nomeZ = mci < 5 ? "Capitulação Extrema" : mci < 10 ? "Capitulação" : mci < 30 ? "Acumulação" : mci < 70 ? "Neutro" : mci < 90 ? "Aquecido" : mci < 98 ? "Alerta Máx." : "Euforia"
corZ  = mci < 5 ? #1d4ed8 : mci < 10 ? #2563eb : mci < 30 ? #22d3ee : mci < 70 ? #34d399 : mci < 90 ? #fbbf24 : mci < 98 ? #f97316 : #ef4444

plot(mci, "MCI", color=corZ, linewidth=2)
hline(98, "Euforia",           color=#ef4444, linestyle=hline.style_dashed)
hline(90, "Alerta Máximo",     color=#f97316, linestyle=hline.style_dashed)
hline(70, "Aquecido",          color=#fbbf24, linestyle=hline.style_dashed)
hline(30, "Acumulação",        color=#22d3ee, linestyle=hline.style_dashed)
hline(10, "Capitulação",       color=#2563eb, linestyle=hline.style_dashed)
hline(5,  "Capitulação Extrema", color=#1d4ed8, linestyle=hline.style_dashed)
bgcolor(color.new(corZ, 92))

var label lbl = na
if barstate.islast
    lbl := label.new(bar_index, mci, "MCI " + str.tostring(mci, "#.#") + " — " + nomeZ, style=label.style_label_left, color=corZ, textcolor=color.white, size=size.small)
