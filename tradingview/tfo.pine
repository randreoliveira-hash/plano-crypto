//@version=5
// TFO v3 — MOMENTO: POSITIVO / NEUTRO / NEGATIVO (sem valuação, só momentum)
// A dose vem do MCI (bot). O TFO responde só a: "o movimento está a virar?"
//
// Lógica (testada nos fundos e topos históricos):
//   POSITIVO (+1): momentum de 60d positivo e a melhorar, OU hashrate recuperou
//                  da capitulação (mineração), OU tendência+momentum saudáveis
//   NEGATIVO  (-1): tendência para baixo + momentum para baixo, sem sinal de viragem
//   NEUTRO    ( 0): tudo o resto (subida tranquila, transições)
// Dados: nativos do TV + GLASSNODE:BTC_HASHRATE (real). Zero valuação.

indicator("TFO v3 — Momento (Positivo/Neutro/Negativo)", shorttitle="TFO", overlay=false, max_bars_back=500)

// ===== Tendência =====
ma200  = ta.sma(close, 200)
tendOK = close > ma200

// ===== Momentum 60d =====
mom60  = close / close[60] - 1
momOK  = mom60 > 0
momBetter = mom60 > mom60[7]

// ===== Hash Ribbon (capitulação de mineradores) =====
// MA30 vs MA60 do hashrate real; capitulação = MA30 < MA60; recuperação = cruza acima depois
h30 = ta.sma(request.security("GLASSNODE:BTC_HASHRATE", "", close, lookahead=barmerge.lookahead_off), 30)
h60 = ta.sma(request.security("GLASSNODE:BTC_HASHRATE", "", close, lookahead=barmerge.lookahead_off), 60)
var bool capAtiva = false
if h30 < h60
    capAtiva := true
if h30 > h60 and capAtiva
    capAtiva := false
hrRecup = h30 > h60 and capAtiva[1] and not capAtiva[0]

// ===== MOMENTO =====
positivo = (momOK and momBetter) or hrRecup or (tendOK and momOK)
negativo = not tendOK and not momOK and not momBetter and not hrRecup
momentoVal = positivo ? 1 : negativo ? -1 : 0
momentoTxt = positivo ? "POSITIVO" : negativo ? "NEGATIVO" : "NEUTRO"
corMomento = positivo ? #22c55e : negativo ? #ef4444 : #9ca3af

// ===== Visual =====
plot(momentoVal, "Momento", color=corMomento, linewidth=3, style=plot.style_columns)
hline(0, "Neutro", color=#888888, linestyle=hline.style_dashed)
bgcolor(color.new(corMomento, 88))

var label lbl = na
if barstate.islast
    lbl := label.new(bar_index, momentoVal, "Momento: " + momentoTxt, style=label.style_label_left, color=corMomento, textcolor=color.white, size=size.normal)

// ===== Alertas =====
alertcondition(momentoVal == 1 and momentoVal[1] != 1, "TFO: Momento POSITIVO", "TFO: momento virou POSITIVO. Com MCI frio do bot = COMPRAR.")
alertcondition(momentoVal == -1 and momentoVal[1] != -1, "TFO: Momento NEGATIVO", "TFO: momento virou NEGATIVO. Reforços pausados.")