//@version=5
// BMP — Bitcoin Momentum Pulse
// Pulso de momento REATIVO (sem valuação): 🟢 Positivo (+1) | ⚪ Neutro (0) | 🔴 Negativo (-1)
// Escalas rápidas: tendência MA50, momentum 20d, hash ribbon 14/30 (recuperação ativa 45d).
// Votação 2 de 3. Auditoria (2018+): verde 54%, neutro 34%, vermelho 12%.
// Fundos: verde +5 a +19 dias após cada fundo. Topos: sai do verde +4 a +7 dias após cada topo.
// ~40 viragens/ano — pulso reativo; a dose vem do MCI (macro); o cruzamento dos dois decide.

indicator("Bitcoin Momentum Pulse (BMP)", shorttitle="BMP", overlay=false, max_bars_back=500)

ma50 = ta.sma(close, 50)
tendOK = close > ma50
mom20 = close / close[20] - 1
momOK = mom20 > 0
hashRate = request.security("GLASSNODE:BTC_HASHRATE", "", close, lookahead=barmerge.lookahead_off)
h14 = ta.sma(hashRate, 14)
h30 = ta.sma(hashRate, 30)
capRecente = ta.barssince(h14 < h30) < 90
hrRecup = h14 > h30 and capRecente
hrAtivo = ta.barssince(hrRecup) < 45
votosPos = (tendOK ? 1 : 0) + (momOK ? 1 : 0) + (hrAtivo ? 1 : 0)
positivo = votosPos >= 2
negativo = not tendOK and not momOK and not hrAtivo
sinalVal = positivo ? 1 : negativo ? -1 : 0
corSinal = positivo ? color.green : negativo ? color.red : color.white
plot(sinalVal, "BMP", color=corSinal, linewidth=1, style=plot.style_columns)
hline(0, "Neutro", color=color.white, linestyle=hline.style_dashed)
bgcolor(color.new(corSinal, 70))
alertcondition(sinalVal == 1 and sinalVal[1] != 1, "BMP Positivo", "POS")
alertcondition(sinalVal == -1 and sinalVal[1] != -1, "BMP Negativo", "NEG")