//@version=5
// BMP - Bitcoin Momentum Pulse (final)
// Binario: verde Positivo / vermelho Negativo. Votacao 2 de 3.
// Votos: tendencia MA50 + momentum 20d + hash ribbon (45d pos-capitulacao).
// Confirmacao: media movel de 9 dias do sinal bruto cruza zero
// (= estado so muda apos ~5 dias consecutivos no novo sentido).
// Auditoria (2018+): frentes verdes com MCI frio: 67% com 60d positivo,
// retorno medio +14,8%. Fundos: verde +12 a +23 dias. Topos: vermelho +9 a +14 dias.

indicator("Bitcoin Momentum Pulse (BMP)", shorttitle="BMP", overlay=false, max_bars_back=500)
ma50 = ta.sma(close, 50)
tendOK = close > ma50
mom20 = close / close[20] - 1
momOK = mom20 > 0
gs = "GLASSNODE:BTC_HASHRATE"
hr = request.security(gs, "", close, lookahead=barmerge.lookahead_off)
h14 = ta.sma(hr, 14)
h30 = ta.sma(hr, 30)
capRecente = ta.barssince(h14 < h30) < 90
hrRecup = h14 > h30 and capRecente
hrAtivo = ta.barssince(hrRecup) < 45
votosPos = (tendOK ? 1 : 0) + (momOK ? 1 : 0) + (hrAtivo ? 1 : 0)
raw = votosPos >= 2 ? 1 : -1
suave = ta.sma(raw, 9)
sinal = suave > 0 ? 1 : -1
verde = color.new(color.green, 40)
verm = color.new(color.red, 40)
branco = color.new(color.white, 40)
corSinal = sinal == 1 ? verde : verm
plot(sinal, "BMP", color=corSinal, style=plot.style_area)
hline(0, "Neutro", color=branco)
bgcolor(color.new(corSinal, 88))
alertcondition(sinal == 1 and sinal[1] != 1, "BMP Positivo", "POS")
alertcondition(sinal == -1 and sinal[1] != -1, "BMP Negativo", "NEG")